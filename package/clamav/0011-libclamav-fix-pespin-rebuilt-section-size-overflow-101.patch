     uint32_t len;
     uint8_t key8;
@@ -402,12 +461,16 @@ int unspin(char *src, int ssize, struct cli_exe_section *sections, int sectcnt,
     len = 0;
     for (j = 0; j < sectcnt; j++) {
         if (bitmap & 1) {
+            if (spin_add_blob_size(&blobsz, sections[j].vsz)) {
+                len = 1;
