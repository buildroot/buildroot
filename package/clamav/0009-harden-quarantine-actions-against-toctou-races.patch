+    if (!S_ISDIR(path_stat.st_mode) ||
+        (path_stat.st_dev != fd_stat.st_dev) ||
+        (path_stat.st_ino != fd_stat.st_ino)) {
+        errno = EAGAIN;
+        return -1;
+    }
+
+    return 0;
