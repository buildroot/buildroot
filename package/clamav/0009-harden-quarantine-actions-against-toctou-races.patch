+static cl_error_t action_source_set_display_path(action_source_t *source, const char *display_path)
+{
+    source->display_path = strdup(display_path);
+    if (NULL == source->display_path) {
+        return CL_EMEM;
+    }
+
+    return CL_SUCCESS;
+}
