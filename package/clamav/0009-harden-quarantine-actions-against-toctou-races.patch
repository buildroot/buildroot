+void action_source_init(action_source_t *source)
+{
+    if (NULL == source) {
+        return;
+    }
+
+    memset(source, 0, sizeof(*source));
+    source->scan_fd = -1;
+#ifdef _WIN32
+    source->handle = INVALID_HANDLE_VALUE;
+#endif
+}
