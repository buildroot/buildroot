comment "mali-imx needs an i.MX platform with a Mali GPU"
	depends on !BR2_PACKAGE_FREESCALE_IMX_HAS_MALI_GPU

comment "mali-imx needs a glibc toolchain with C++"
	depends on BR2_aarch64
	depends on BR2_PACKAGE_FREESCALE_IMX_HAS_MALI_GPU
	depends on !BR2_TOOLCHAIN_USES_GLIBC || !BR2_INSTALL_LIBSTDCPP

config BR2_PACKAGE_MALI_IMX
	bool "mali-imx"
	depends on BR2_aarch64
	depends on BR2_PACKAGE_FREESCALE_IMX_HAS_MALI_GPU
	# Library binaries are linked against libc.so.6
	depends on BR2_TOOLCHAIN_USES_GLIBC
	# Library binaries are linked against libstdc++.so.6
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HAS_LIBOPENCL
	select BR2_PACKAGE_HAS_LIBGBM
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_DMA_BUF
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_FORMAT_MODIFIER_PLANE_COUNT
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_WAYLAND
	help
	  Userspace libraries and firmware for Mali GPU on
	  i.MX95 platforms.

	  This library is provided by Freescale as-is and
	  doesn't have an upstream.

if BR2_PACKAGE_MALI_IMX

config BR2_PACKAGE_PROVIDES_LIBGBM
	default "mali-imx"

config BR2_PACKAGE_PROVIDES_LIBEGL
	default "mali-imx"

config BR2_PACKAGE_PROVIDES_LIBGLES
	default "mali-imx"

config BR2_PACKAGE_PROVIDES_LIBOPENCL
	default "mali-imx"

config BR2_PACKAGE_MALI_IMX_COMPILERS
	bool "install Mali offline compilers"
	help
	  Copy the Mali Shader offline compiler and the
	  Mali OpenCL offline compiler to the target.

	  Warning: compilers take approximately 100 MB of
	  disk space.

endif
